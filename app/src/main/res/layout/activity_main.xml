<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/deliveryLayout"
            layout="@layout/fragment_delivery"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/customersLayout"
            layout="@layout/fragment_customers"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/addCustomerLayout"
            layout="@layout/fragment_add_customer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/historyLayout"
            layout="@layout/fragment_history"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/customerBillingHistoryLayout"
            layout="@layout/fragment_customer_billing_history"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/billDetailsLayout"
            layout="@layout/fragment_bill_details"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/itemsLayout"
            layout="@layout/fragment_items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/stockManagementLayout"
            layout="@layout/fragment_stock_management"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/settingsLayout"
            layout="@layout/fragment_settings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/addItemLayout"
            layout="@layout/fragment_add_item"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/addGRNLayout"
            layout="@layout/fragment_add_grn"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/drawer_bg"
        app:headerLayout="@layout/nav_header"
        app:itemBackground="@drawable/nav_item_background"
        app:itemIconPadding="20dp"
        app:itemIconTint="@color/nav_item_tint"
        app:itemShapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize12"
        app:itemShapeInsetEnd="16dp"
        app:itemShapeInsetStart="16dp"
        app:itemTextAppearance="@style/NavMenuItemAppearance"
        app:itemTextColor="@color/nav_item_tint"
        app:itemVerticalPadding="12dp"
        app:menu="@menu/drawer_menu">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:background="#2D3748" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavSettings"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:gravity="start|center_vertical"
                android:paddingVertical="12dp"
                android:text="Settings"
                android:textAllCaps="false"
                android:textColor="@color/nav_item_tint"
                android:textSize="16sp"
                app:icon="@drawable/ic_settings"
                app:iconPadding="20dp"
                app:iconTint="@color/nav_item_tint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavHelp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:gravity="start|center_vertical"
                android:paddingVertical="12dp"
                android:text="Help &amp; Support"
                android:textAllCaps="false"
                android:textColor="@color/nav_item_tint"
                android:textSize="16sp"
                app:icon="@android:drawable/ic_menu_help"
                app:iconPadding="20dp"
                app:iconTint="@color/nav_item_tint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavLogout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/nav_logout_bg"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Logout"
                android:textAllCaps="false"
                android:textColor="@color/nav_logout_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_logout"
                app:iconPadding="20dp"
                app:iconTint="@color/nav_logout_text" />

        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>