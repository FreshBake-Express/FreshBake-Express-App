<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_stat_bills"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvCustomerAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_filter_unselected"
        android:gravity="center"
        android:text="AP"
        android:textColor="@color/primary_green"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvCustomerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Aarav Patel"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/tvCustomerAvatar"
        app:layout_constraintTop_toTopOf="@id/tvCustomerAvatar" />

    <TextView
        android:id="@+id/tvStoreName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sunrise Grocery"
        android:textColor="@color/text_grey"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tvCustomerName"
        app:layout_constraintTop_toBottomOf="@id/tvCustomerName" />

    <TextView
        android:id="@+id/tvCustomerPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="4dp"
        android:text="+91 98765 43210"
        android:textColor="@color/text_grey"
        android:textSize="10sp"
        app:drawableStartCompat="@android:drawable/ic_menu_call"
        app:drawableTint="@color/text_grey"
        app:layout_constraintStart_toStartOf="@id/tvCustomerName"
        app:layout_constraintTop_toBottomOf="@id/tvStoreName" />

    <TextView
        android:id="@+id/tvCustomerTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹1,240"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvCustomerName" />

    <TextView
        android:id="@+id/tvCustomerDue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_stat_due"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="Due ₹240"
        android:textColor="@color/due_text"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCustomerTotal" />

</androidx.constraintlayout.widget.ConstraintLayout>